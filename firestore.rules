rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function estConnecte() {
      return request.auth != null;
    }

    function estAdmin() {
      return estConnecte() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Chaque utilisateur peut lire sa propre fiche (rôle) ; l'admin peut
    // aussi lire toutes les fiches pour afficher la liste des commerciaux.
    // La création d'un compte commercial se fait depuis l'app (par l'admin,
    // via un compte Firebase Auth secondaire) : seul l'admin peut créer une
    // fiche, et uniquement avec le rôle "commercial" (jamais "admin", pour
    // empêcher toute élévation de privilège). Modification/suppression
    // restent réservées à la console Firebase.
    match /users/{userId} {
      allow read: if estConnecte() && (request.auth.uid == userId || estAdmin());
      allow create: if estAdmin() && request.resource.data.role == 'commercial';
      allow update, delete: if false;
    }

    // Catalogue partagé : tout utilisateur connecté peut consulter,
    // seul l'admin (PC) peut modifier.
    match /familles/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /articles/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    // Clients, commandes et notes appartiennent au compte qui les a créés :
    // un commercial ne voit que les siens. L'admin peut en plus les *lire*
    // (jamais les modifier/supprimer) pour n'importe quel compte, pour
    // consulter la session d'un commercial sans se déconnecter de la
    // sienne — voir VueCommercialScreen.
    match /clients/{id} {
      allow read: if estConnecte() &&
        (request.auth.uid == resource.data.ownerUid || estAdmin());
      allow update, delete: if estConnecte() &&
        request.auth.uid == resource.data.ownerUid;
      allow create: if estConnecte() &&
        request.resource.data.ownerUid == request.auth.uid;
    }

    match /commandes/{id} {
      allow read: if estConnecte() &&
        (request.auth.uid == resource.data.ownerUid || estAdmin());
      allow update, delete: if estConnecte() &&
        request.auth.uid == resource.data.ownerUid;
      allow create: if estConnecte() &&
        request.resource.data.ownerUid == request.auth.uid;
    }

    match /notes/{id} {
      allow read: if estConnecte() &&
        (request.auth.uid == resource.data.ownerUid || estAdmin());
      allow update, delete: if estConnecte() &&
        request.auth.uid == resource.data.ownerUid;
      allow create: if estConnecte() &&
        request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
